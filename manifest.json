{
    "manifest_version": 3,
    "name": "Zalo Cloud upload extension",
    "key": "",
    "version": "1.0.0",
    "description": "Bắt file kéo thả trên Zalo Web và upload lên Google Drive/OneDrive.",
    "icons": {
        "16": "assets/icon-16.png",
        "128": "assets/icon-128.png"
    },
    "permissions": [
        "storage",
        "identity"
    ],
    "host_permissions": [
        "https://www.googleapis.com/*",
        "https://graph.microsoft.com/*",
        "https://www.dropbox.com/*",
        "https://content.dropboxapi.com/*",
        "https://api.dropboxapi.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://chat.zalo.me/*"
            ],
            "js": [
                "src/content/content_script.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "service_worker": "src/background/service_worker.js",
        "type": "module"
    },
    "oauth2": {
        "client_id": "819026827832-5ruu50dkv4ijvrf46nfinuutpsm6v84m.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/drive.file",
            "https://www.googleapis.com/auth/drive.metadata.readonly"
        ]
    },
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "16": "assets/icon-16.png",
            "128": "assets/icon-128.png"
        }
    }
}